# Server
PORT=3000
NODE_ENV=development

# CORS — comma-separated origins (Vercel URL + localhost)
FRONTEND_URL=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Concert
CONCERT_DATE=2025-12-31T20:00:00+07:00
TICKET_PRICE_VND=350000
MAX_TICKETS=200

# VietQR thanh toán (ảnh trong public/images/, URL tương đối hoặc tuyệt đối)
PAYMENT_QR_URL=/images/vietqr-payment.png
# Tuỳ chọn: đường dẫn tuyệt đối tới file PNG (email đính kèm VietQR)
# PAYMENT_QR_FILE=
BANK_ACCOUNT_NAME=DOAN MINH QUAN
BANK_ACCOUNT_NUMBER=7880368737
BANK_NAME=BIDV

# Email (Gmail: use App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=NÓN CONCERT <noreply@nonconcert.local>

# Optional: skip sending mail when SMTP not configured (dev)
SKIP_EMAIL=false

# Admin dashboard — bắt buộc đặt mật khẩu
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Chuỗi bí mật ký session (đổi thành random dài trên production)
SESSION_SECRET=thay-bang-chuoi-ngau-nhien-dai

# Cho phép nút "Xóa hết vé" trên admin (đặt false trên production thật nếu cần)
ADMIN_ALLOW_RESET=true
